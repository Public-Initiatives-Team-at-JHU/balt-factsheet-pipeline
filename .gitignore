# Data - ignore contents but keep directory structure via .gitkeep
data/00 raw/*
data/01 clean/*
data/02 processed/*
!data/00 raw/.gitkeep
!data/01 clean/.gitkeep
!data/02 processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Office temp files
~$*
